<mxfile host="Claude"><diagram name="Przepływ przełączenia"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Przepływ przełączenia · czasy z logów keepalived i FRR" style="text;html=1;align=left;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="f1" value="Przełączenie na bramę zapasową" style="swimlane;rounded=1;arcSize=8;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="720" height="250" as="geometry"/></mxCell><mxCell id="f1r0" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#10739e;font-weight:bold&quot;&gt;0 s&lt;/span&gt;&lt;b&gt;gw-01 kończy pracę i wysyła ogłoszenie VRRP z priorytetem 0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:70px&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#666666&quot;&gt;przy nagłej awarii ogłoszeń po prostu brak&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f1"><mxGeometry y="30" width="720" height="44" as="geometry"/></mxCell><mxCell id="f1r1" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#10739e;font-weight:bold&quot;&gt;0,4 s&lt;/span&gt;&lt;b&gt;gw-02 zostaje MASTER: adresy WAN, LAN i DMZ, gratuitous ARP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:70px&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#666666&quot;&gt;przy nagłej awarii: 3 × 1 s + 106/256 s ≈ 3,4 s&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f1"><mxGeometry y="74" width="720" height="44" as="geometry"/></mxCell><mxCell id="f1r2" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#10739e;font-weight:bold&quot;&gt;0,4 s&lt;/span&gt;&lt;b&gt;notify_master: trasy WAN, conntrackd, BIND, cron&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:70px&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#666666&quot;&gt;sieci WAN do tablicy operatora, przejęcie stanu połączeń&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f1"><mxGeometry y="118" width="720" height="44" as="geometry"/></mxCell><mxCell id="f1r3" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#10739e;font-weight:bold&quot;&gt;&lt; 1 s&lt;/span&gt;&lt;b&gt;LAN działa: bramy VLAN-ów, DHCP, DNS, ruch wewnętrzny i VPN&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f1"><mxGeometry y="162" width="720" height="44" as="geometry"/></mxCell><mxCell id="f1r4" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#b46504;font-weight:bold&quot;&gt;~57 s&lt;/span&gt;&lt;b&gt;BGP zestawione na gw-02: wraca internet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:70px&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#666666&quot;&gt;operator zamyka starą sesję dopiero po swoim keepalive&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f1"><mxGeometry y="206" width="720" height="44" as="geometry"/></mxCell><mxCell id="f2" value="Powrót bramy głównej" style="swimlane;rounded=1;arcSize=8;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="720" height="162" as="geometry"/></mxCell><mxCell id="f2r0" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#10739e;font-weight:bold&quot;&gt;0 s&lt;/span&gt;&lt;b&gt;gw-01 startuje jako BACKUP i słyszy ogłoszenia gw-02&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f2"><mxGeometry y="30" width="720" height="44" as="geometry"/></mxCell><mxCell id="f2r1" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#10739e;font-weight:bold&quot;&gt;3,22 s&lt;/span&gt;&lt;b&gt;gw-01 odbiera rolę MASTER, gw-02 wykonuje notify_backup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:70px&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#666666&quot;&gt;3 × 1 s + 56/256 s, za każdym razem tyle samo&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f2"><mxGeometry y="74" width="720" height="44" as="geometry"/></mxCell><mxCell id="f2r2" value="&lt;span style=&quot;display:inline-block;width:70px;font-family:Courier New;font-size:13px;color:#b46504;font-weight:bold&quot;&gt;~28 s&lt;/span&gt;&lt;b&gt;BGP zestawione na gw-01: wraca internet&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;html=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="f2"><mxGeometry y="118" width="720" height="44" as="geometry"/></mxCell><mxCell id="s1" value="&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;LAN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:24px;font-weight:bold;color:#10739e&quot;&gt;&amp;lt; 4 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;bramy, DHCP, DNS, ruch wewnętrzny&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="502" width="350" height="92" as="geometry"/></mxCell><mxCell id="s2" value="&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Internet&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:24px;font-weight:bold;color:#b46504&quot;&gt;30-60 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#555&quot;&gt;do zestawienia sesji BGP&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="390" y="502" width="350" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>